# ---- Rust / Cargo build artifacts ----
/target/
**/*.rs.bk

# NOTE: Cargo.lock is intentionally committed. This workspace ships a binary
# (the `oxide` CLI), and applications commit their lockfile for reproducible
# builds. Only *library-only* crates should ignore it.

# ---- Runtime artifacts generated by the shell ----
# (audit logs, timing logs, etc.)
*.log
history.txt
.oxide_history
# sandbox ("jail") working directory
oxide_jail/

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini
